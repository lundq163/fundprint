{
  "manifest_version": 3,
  "name": "Fundprint (dev)",
  "version": "0.1.0",
  "description": "Nonpartisan transparency tool: hover over a federal candidate's name on any page to see how their campaign is funded, from official FEC data.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "options/options.html",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "common/matcher.js",
        "common/storage.js",
        "data/legislators.json",
        "content/card.js",
        "detail/candidate.html",
        "detail/funder.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "https://api.open.fec.gov/*"
  ]
}
